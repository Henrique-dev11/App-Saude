{
  "expo": {
    "name": "projetoSemestre",
    "slug": "projetoSemestre",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      ["expo-location", {
        "locationWhenInUsePermission": "Permita sua localização para encontrar as UBS mais próximas neste catálogo.",
        "locationAlwaysAndWhenInUsePermission": false,
        "locationAlwaysPermission": false,
        "motionUsagePermission": false,
        "isIosBackgroundLocationEnabled": false,
        "isAndroidBackgroundLocationEnabled": false,
        "isAndroidForegroundServiceEnabled": false
      }],
      ["expo-image-picker", {
        "photosPermission": "Permita o acesso à galeria para adicionar sua foto de perfil.",
        "cameraPermission": false,
        "microphonePermission": false
      }]
    ]
  }
}
